datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Problem {
  id          String    @id @default(uuid())
  title       String
  description String
  constraints String
  difficulty  String // Easy | Medium | Hard
  tags        String // JSON string array or comma-separated
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  attempts    Attempt[]
}

model Attempt {
  id          String       @id @default(uuid())
  problemId   String
  problem     Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  learnerId   String       @default("learner-default")
  status      String // InProgress | Submitted
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  submissions Submission[]
}

model Submission {
  id             String      @id @default(uuid())
  attemptId      String
  attempt        Attempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  format         String      @default("Text") // Text
  content        String
  idempotencyKey String?     @unique
  submittedAt    DateTime    @default(now())
  evaluation     Evaluation?
}

model Evaluation {
  id            String            @id @default(uuid())
  submissionId  String            @unique
  submission    Submission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  status        String // Queued | Evaluating | Completed | Failed
  evaluatorType String // RuleBased | AI | Hybrid
  errorMessage  String?
  createdAt     DateTime          @default(now())
  completedAt   DateTime?
  result        EvaluationResult?
}

model EvaluationResult {
  id               String           @id @default(uuid())
  evaluationId     String           @unique
  evaluation       Evaluation       @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  overallSummary   String
  strengths        String // JSON string array
  improvementAreas String // JSON string array
  criterionScores  CriterionScore[]
}

model CriterionScore {
  id                 String           @id @default(uuid())
  evaluationResultId String
  evaluationResult   EvaluationResult @relation(fields: [evaluationResultId], references: [id], onDelete: Cascade)
  criterion          String // RequirementUnderstanding | ResponsibilityAssignment | CouplingCohesion | Encapsulation | AbstractionUsage | Extensibility | EdgeCaseHandling | ExplanationQuality
  score              Int // 1-5
  evidence           String
  concern            String?
  suggestion         String
  confidence         Float // 0.0 - 1.0
}
